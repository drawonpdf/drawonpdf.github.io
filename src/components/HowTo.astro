---
import { useTranslations, type SupportedLanguage } from '../i18n/utils';

export interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const supportUrl = 'https://buymeacoffee.com/kisharadilz';

const steps = [
  {
    num: '01',
    title: t('step1Title'),
    desc: t('step1Desc'),
    icon: `<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>`
  },
  {
    num: '02',
    title: t('step2Title'),
    desc: t('step2Desc'),
    icon: `<path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/>`
  },
  {
    num: '03',
    title: t('step3Title'),
    desc: t('step3Desc'),
    icon: `<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>`
  }
];
---

<section id="how-it-works" class="py-16 sm:py-24 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        {t('howToHeading')}
      </h2>
      <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-400">
        {t('howToSubheading')}
      </p>
    </div>

    <!-- 3-Step Process Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {steps.map((step, idx) => (
        <div class="relative p-7 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-5">
              <span class="text-3xl font-black text-[#659287] dark:text-[#88BDA4] opacity-90">
                {step.num}
              </span>
              <div class="w-10 h-10 rounded-lg bg-[#E6F2DD] dark:bg-[#659287]/20 border border-[#B1D3B9] dark:border-[#659287]/40 text-[#659287] dark:text-[#88BDA4] flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={step.icon} />
              </div>
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
              {step.title}
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {step.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Developer Support CTA Card -->
    <div class="mt-14 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-amber-500/10 via-amber-500/5 to-transparent border border-amber-400/30 dark:border-amber-500/20 max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4 text-left">
        <div class="w-14 h-14 shrink-0 rounded-2xl bg-[#FFDD00] flex items-center justify-center text-slate-950 shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
            <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
            <line x1="6" y1="1" x2="6" y2="4"></line>
            <line x1="10" y1="1" x2="10" y2="4"></line>
            <line x1="14" y1="1" x2="14" y2="4"></line>
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">
            {t('supportCardTitle')}
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1 max-w-xl">
            {t('supportCardDesc')}
          </p>
        </div>
      </div>
      <a
        href={supportUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 px-5 py-3 rounded-xl bg-[#FFDD00] hover:bg-[#f2cf00] text-slate-950 font-bold text-sm shadow hover:shadow-md active:scale-95 transition-all flex items-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
        {t('supportCardButton')}
      </a>
    </div>
  </div>
</section>
