---
import { useTranslations, type SupportedLanguage } from '../i18n/utils';

export interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const features = [
  {
    title: t('feat1Title'),
    desc: t('feat1Desc'),
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
    gradient: 'from-emerald-500/20 to-teal-500/20 text-emerald-600 dark:text-emerald-400',
  },
  {
    title: t('feat2Title'),
    desc: t('feat2Desc'),
    icon: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>`,
    gradient: 'from-blue-500/20 to-indigo-500/20 text-blue-600 dark:text-blue-400',
  },
  {
    title: t('feat3Title'),
    desc: t('feat3Desc'),
    icon: `<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>`,
    gradient: 'from-amber-500/20 to-orange-500/20 text-amber-600 dark:text-amber-400',
  },
  {
    title: t('feat4Title'),
    desc: t('feat4Desc'),
    icon: `<path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>`,
    gradient: 'from-purple-500/20 to-pink-500/20 text-purple-600 dark:text-purple-400',
  },
  {
    title: t('feat5Title'),
    desc: t('feat5Desc'),
    icon: `<rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>`,
    gradient: 'from-cyan-500/20 to-blue-500/20 text-cyan-600 dark:text-cyan-400',
  },
  {
    title: t('feat6Title'),
    desc: t('feat6Desc'),
    icon: `<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>`,
    gradient: 'from-rose-500/20 to-red-500/20 text-rose-600 dark:text-rose-400',
  },
];
---

<section id="features" class="py-16 sm:py-24 border-t border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-900/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-[#659287] dark:text-[#88BDA4] bg-[#E6F2DD] dark:bg-[#659287]/20 px-3 py-1 rounded-full border border-[#B1D3B9] dark:border-[#659287]/40">
        {t('teacherBadge')}
      </span>
      <h2 class="mt-3 text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        {t('featuresHeading')}
      </h2>
      <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-400">
        {t('featuresSubheading')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {features.map((feat) => (
        <div class="group relative p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md hover:border-[#88BDA4] dark:hover:border-[#659287] transition-all duration-200 flex flex-col">
          <div class={`w-12 h-12 rounded-xl flex items-center justify-center mb-4 bg-gradient-to-br ${feat.gradient} border border-current/10`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={feat.icon} />
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2 group-hover:text-[#659287] dark:group-hover:text-[#88BDA4] transition-colors">
            {feat.title}
          </h3>
          <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            {feat.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
