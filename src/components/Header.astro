---
import { useTranslations, languages, getLocalizedPath, type SupportedLanguage, defaultLang } from '../i18n/utils';

export interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const homePath = lang === defaultLang ? '/' : `/${lang}/`;
const supportUrl = 'https://buymeacoffee.com/kisharadilz';
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md transition-colors">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-2">
    <!-- Brand Logo -->
    <a href={homePath} class="flex items-center gap-2.5 group focus:outline-none focus:ring-2 focus:ring-[#659287] rounded-lg p-1">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-[#659287] to-[#88BDA4] flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-lg leading-tight tracking-tight text-slate-900 dark:text-white flex items-center gap-1.5">
          DrawOnPDF
          <span class="hidden sm:inline-block text-[10px] uppercase tracking-wider font-extrabold bg-[#E6F2DD] text-[#659287] dark:bg-[#659287]/30 dark:text-[#B1D3B9] px-1.5 py-0.5 rounded border border-[#B1D3B9]/50 dark:border-[#659287]/40">
            Free
          </span>
        </span>
        <span class="hidden md:inline-block text-xs text-slate-500 dark:text-slate-400 font-medium">
          {t('brandTagline')}
        </span>
      </div>
    </a>

    <!-- Action Controls: Fullscreen, Language, Theme, Support -->
    <div class="flex items-center gap-1 sm:gap-2">
      <!-- Fullscreen Toggle Button (Desktop & Tablets) -->
      <button
        id="fullscreen-toggle"
        type="button"
        title={t('fullscreen')}
        aria-label={t('fullscreen')}
        class="hidden sm:inline-flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 rounded-lg text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-[#659287]"
      >
        <svg id="fs-enter-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 2 2h3"></path>
        </svg>
        <svg id="fs-exit-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"></path>
        </svg>
      </button>

      <!-- Language Picker Dropdown -->
      <div class="relative group">
        <button
          type="button"
          aria-label={t('languageSelect')}
          aria-haspopup="true"
          aria-expanded="false"
          class="inline-flex items-center gap-1 sm:gap-1.5 px-2 sm:px-2.5 py-1 sm:py-1.5 text-xs font-semibold rounded-lg text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 transition-colors focus:outline-none focus:ring-2 focus:ring-[#659287]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-[#659287] dark:text-[#88BDA4] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span class="uppercase tracking-wider">{lang}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <div class="absolute right-0 mt-1.5 w-36 py-1 bg-white dark:bg-slate-900 rounded-xl shadow-xl border border-slate-200 dark:border-slate-800 opacity-0 invisible group-hover:opacity-100 group-hover:visible focus-within:opacity-100 focus-within:visible transition-all duration-150 z-50">
          {Object.entries(languages).map(([code, name]) => {
            const path = getLocalizedPath('/', code as SupportedLanguage);
            const isCurrent = code === lang;
            return (
              <a
                href={path}
                class={`flex items-center justify-between px-3 py-1.5 text-xs font-medium transition-colors ${
                  isCurrent
                    ? 'text-[#659287] dark:text-[#88BDA4] bg-[#E6F2DD] dark:bg-[#659287]/20 font-bold'
                    : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800'
                }`}
              >
                <span>{name}</span>
                {isCurrent && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-[#659287] dark:text-[#88BDA4]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                )}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Dark / Light Theme Toggle -->
      <button
        id="theme-toggle"
        type="button"
        title={t('themeDark')}
        aria-label="Toggle theme"
        class="inline-flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 rounded-lg text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <!-- Sun Icon (Shown in Dark Mode) -->
        <svg id="theme-sun" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 hidden dark:block text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon Icon (Shown in Light Mode) -->
        <svg id="theme-moon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 block dark:hidden text-slate-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Prominent "Support the Developer" Buy Me a Coffee Button -->
      <a
        href={supportUrl}
        target="_blank"
        rel="noopener noreferrer"
        title={t('supportTooltip')}
        class="inline-flex items-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-1 sm:py-1.5 rounded-lg font-semibold text-xs text-slate-900 bg-[#FFDD00] hover:bg-[#f2cf00] active:scale-95 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-amber-400 shrink-0"
      >
        <!-- Coffee Cup Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-slate-900 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
          <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
          <line x1="6" y1="1" x2="6" y2="4"></line>
          <line x1="10" y1="1" x2="10" y2="4"></line>
          <line x1="14" y1="1" x2="14" y2="4"></line>
        </svg>
        <span class="hidden sm:inline font-bold">{t('supportDeveloper')}</span>
        <span class="sm:hidden font-bold text-[11px]">Coffee</span>
      </a>
    </div>
  </div>
</header>

<!-- Header Scripts: Theme Switcher & Fullscreen Handlers -->
<script is:inline>
  // Theme Toggle Logic
  var themeToggleBtn = document.getElementById('theme-toggle');
  if (themeToggleBtn) {
    themeToggleBtn.addEventListener('click', function() {
      var isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  }

  // Fullscreen Logic
  var fsBtn = document.getElementById('fullscreen-toggle');
  var fsEnterIcon = document.getElementById('fs-enter-icon');
  var fsExitIcon = document.getElementById('fs-exit-icon');

  function updateFsIcons() {
    if (document.fullscreenElement) {
      if (fsEnterIcon) fsEnterIcon.classList.add('hidden');
      if (fsExitIcon) fsExitIcon.classList.remove('hidden');
    } else {
      if (fsEnterIcon) fsEnterIcon.classList.remove('hidden');
      if (fsExitIcon) fsExitIcon.classList.add('hidden');
    }
  }

  if (fsBtn) {
    fsBtn.addEventListener('click', function() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(function(err) {
          console.warn('Fullscreen request failed:', err);
        });
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen().catch(function(err) {
            console.warn('Exit fullscreen failed:', err);
          });
        }
      }
    });

    document.addEventListener('fullscreenchange', updateFsIcons);
  }
</script>
