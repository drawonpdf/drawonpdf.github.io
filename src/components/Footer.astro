---
import { useTranslations, languages, getLocalizedPath, type SupportedLanguage } from '../i18n/utils';

export interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const supportUrl = 'https://buymeacoffee.com/kisharadilz';
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 py-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-slate-100 dark:border-slate-800/80">
      <!-- Logo & Mission -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left gap-1.5">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-[#659287] to-[#88BDA4] flex items-center justify-center text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          </div>
          <span class="font-bold text-base tracking-tight text-slate-900 dark:text-white">
            DrawOnPDF
          </span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm">
          {t('footerText')}
        </p>
      </div>

      <!-- Privacy & Developer Support Button -->
      <div class="flex flex-col sm:flex-row items-center gap-4">
        <div class="flex items-center gap-2 text-xs font-semibold text-[#659287] dark:text-[#88BDA4] bg-[#E6F2DD] dark:bg-[#659287]/20 border border-[#B1D3B9] dark:border-[#659287]/40 px-3 py-1.5 rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>{t('footerPrivacy')}</span>
        </div>

        <a
          href={supportUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-[#FFDD00] hover:bg-[#f2cf00] text-slate-900 text-xs font-bold shadow-sm active:scale-95 transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
            <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
            <line x1="6" y1="1" x2="6" y2="4"></line>
            <line x1="10" y1="1" x2="10" y2="4"></line>
            <line x1="14" y1="1" x2="14" y2="4"></line>
          </svg>
          <span>{t('supportDeveloper')}</span>
        </a>
      </div>
    </div>

    <!-- Language Links & Copyright -->
    <div class="pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        {Object.entries(languages).map(([code, name]) => {
          const path = getLocalizedPath('/', code as SupportedLanguage);
          const isCurrent = code === lang;
          return (
            <a
              href={path}
              class={`hover:text-[#659287] dark:hover:text-[#88BDA4] transition-colors ${
                isCurrent ? 'font-bold text-[#659287] dark:text-[#88BDA4]' : ''
              }`}
            >
              {name}
            </a>
          );
        })}
      </div>

      <p>© {currentYear} {t('footerCopyright')}</p>
    </div>
  </div>
</footer>
