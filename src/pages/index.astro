---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import DrawWorkspace from '../components/DrawWorkspace.jsx';
import Features from '../components/Features.astro';
import HowTo from '../components/HowTo.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout lang={lang}>
  <Header lang={lang} />

  <main class="flex-1 flex flex-col">
    <!-- Screen-Reader & Crawler Primary Heading for 100% Semantic SEO -->
    <h1 class="sr-only">{t('metaTitle')}</h1>

    <!-- Interactive Canvas Workspace Island (Full Device Size) -->
    <div class="w-full h-[calc(100vh-64px)] sm:h-[calc(100vh-64px)] lg:h-[calc(100dvh-64px)] min-h-[560px] flex flex-col">
      <DrawWorkspace client:load lang={lang} />
    </div>

    <!-- SEO Content Sections -->
    <Features lang={lang} />
    <HowTo lang={lang} />
    <FaqSection lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
